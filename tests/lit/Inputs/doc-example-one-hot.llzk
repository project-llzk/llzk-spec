// Derived from the Zirgen example:
//
// component OneHot<N: Val>(v: Val) {
//   // Make N bit registers, with bit v set and all others 0
//   public bits := for i : 0..N { NondetBitReg(Isz(i - v)) };
//   // Verify exactly one bit is set
//   reduce bits init 0 with Add = 1;
//   // Verify the right bit is set
//   reduce for i : 0..N { bits[i] * i } init 0 with Add = v;
//   bits
// }

!F = !felt.type<"babybear">

module attributes { llzk.lang = "zirgen" } {
  poly.template @OneHotTemplate {
    poly.param @N : index

    struct.def @OneHot {
      struct.member @bits : !array.type<@N x !F> {llzk.pub, signal}
      function.def @compute(%v : !F) -> !struct.type<@OneHotTemplate::@OneHot<[@N]>> attributes {function.allow_non_native_field_ops, function.allow_witness} {
        %self = struct.new : <@OneHotTemplate::@OneHot<[@N]>>
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        %n = poly.read_const @N : index
        %f0 = felt.const 0 : !F
        %f1 = felt.const 1 : !F

        %bits = array.new : !array.type<@N x !F>

        scf.for %i = %c0 to %n step %c1 {
          %i_felt = cast.tofelt %i : index, !F
          %res = felt.sub %i_felt, %v : !F, !F
          %is_zero = bool.cmp eq(%res, %f0) : !F, !F
          %is_selected = bool.cmp eq(%i_felt, %v) : !F, !F
          %bit = scf.if %is_zero -> (!F) {
            scf.yield %f1 : !F
          } else {
            scf.yield %f0 : !F
          }
          array.write %bits[%i] = %bit : !array.type<@N x !F>, !F
        }
        struct.writem %self[@bits] = %bits : <@OneHotTemplate::@OneHot<[@N]>>, !array.type<@N x !F>
        function.return %self : !struct.type<@OneHotTemplate::@OneHot<[@N]>>
      }
      function.def @constrain(%arg0: !struct.type<@OneHotTemplate::@OneHot<[@N]>>, %v : !F) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
        %bits = struct.readm %arg0[@bits] : <@OneHotTemplate::@OneHot<[@N]>>, !array.type<@N x !F>
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        %n = poly.read_const @N : index
        %f0 = felt.const 0 : !F
        %f1 = felt.const 1 : !F
        %right_bit_sum:2 = scf.for %i = %c0 to %n step %c1 iter_args(%count = %f0, %weighted = %f0) -> (!F, !F) {
          %i_felt = cast.tofelt %i : index, !F
          %is_selected = bool.cmp eq(%i_felt, %v) : !F, !F
          %bit = scf.if %is_selected -> (!F) {
            scf.yield %f1 : !F
          } else {
            scf.yield %f0 : !F
          }
          %next_count = felt.add %count, %bit : !F, !F
          %weighted_bit = felt.mul %bit, %i_felt : !F, !F
          %next_weighted = felt.add %weighted, %weighted_bit : !F, !F
          scf.yield %next_count, %next_weighted : !F, !F
        }
        %exactly_one = bool.cmp eq(%right_bit_sum#0, %f1) : !F, !F
        %right_index = bool.cmp eq(%right_bit_sum#1, %v) : !F, !F
        %true = arith.constant true
        constrain.eq %exactly_one, %true : i1
        constrain.eq %right_index, %true : i1
        function.return
      }
    }
  }
}
