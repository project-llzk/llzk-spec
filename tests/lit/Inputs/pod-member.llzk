module attributes { llzk.lang } {
    struct.def @Bar {
      struct.member @foo : !struct.pod<[@out : index]>
      function.def @compute() -> !struct.type<@Bar<[]>> attributes {function.allow_non_native_field_ops, function.allow_witness} {
        %self = struct.new : <@Bar<[]>>
        %0 = function.call @Foo::@compute() : () -> !struct.type<@Foo<[]>>
        struct.writem %self[@foo] = %0 : !struct.type<@Bar<[]>>, !struct.type<@Foo<[]>>
        function.return %self : !struct.type<@Bar<[]>>
      }
      function.def @constrain(%self: !struct.type<@Bar<[]>>) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
        %0 = struct.readm %self[@foo] : !struct.type<@Bar<[]>>, !struct.type<@Foo<[]>>
        function.call @Foo::@contrain(%0)  : (!struct.type<@Foo<[]>>) -> ()
        function.return
      }
    }
}
